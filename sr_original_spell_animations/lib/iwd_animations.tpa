LAF srio_check_child STR_VAR srio_root = ~SPWI413~ srio_child = ~SPWI413A~ RET srio_linked END
ACTION_IF srio_linked BEGIN

ACTION_IF FILE_EXISTS_IN_GAME ~SPWI413A.spl~ BEGIN
  COPY_EXISTING ~SPWI413A.spl~ ~override~
    LPF srio_replace INT_VAR srio_op = 215 srio_p2 = 1 srio_target = 2 srio_loop = 1 srio_expected = 1
      STR_VAR srio_old = ~MINORGLB~ srio_new = ~srioosph~ END
  BUT_ONLY_IF_IT_CHANGES
END ELSE BEGIN PRINT ~IWD Spell Animations: SPWI413A.spl missing, skipped.~ END
END ELSE BEGIN PRINT ~IWD Spell Animations: SPWI413.spl no longer calls SPWI413A.spl after casting; skipped.~ END

LAF srio_check_child STR_VAR srio_root = ~SPPR712~ srio_child = ~SPPR712A~ RET srio_linked END
ACTION_IF srio_linked BEGIN

ACTION_IF FILE_EXISTS_IN_GAME ~SPPR712A.spl~ BEGIN
  COPY_EXISTING ~SPPR712A.spl~ ~override~
    LPF srio_replace INT_VAR srio_op = 215 srio_p2 = 0 srio_target = 2 srio_loop = 0 srio_expected = 1
      STR_VAR srio_old = ~ICRAISEI~ srio_new = ~srioress~ END
